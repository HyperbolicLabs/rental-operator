{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "The Kubernetes libraries and controller-runtime move together.",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/controller-runtime"],
      "groupName": "kubernetes"
    }
  ],
  "customManagers": [
    {
      "description": "Versions marked with a renovate comment in the Makefile and the workflows.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_]+\\s*\\??[:=]\\s*(?<currentValue>v[0-9][^\\s]*)"
      ]
    }
  ]
}
